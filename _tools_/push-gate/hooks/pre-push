#!/usr/bin/env node
// CU-337 (D-097): git's pre-push hook - the public-hygiene gate's exit status alone decides the push.
// Installed by `node _tools_/push-gate/install.mjs` (core.hooksPath); see ../INDEX.md.
import { readFileSync } from 'node:fs'

import { prePush } from '../push-gate.mjs'

const input = readFileSync(0, 'utf8')
process.exitCode = prePush({ input, remote: process.argv[2] || 'origin' })
